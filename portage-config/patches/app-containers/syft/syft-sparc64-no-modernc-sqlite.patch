modernc.org/sqlite needs modernc.org/libc, which has no linux/sparc64
port. Leave the driver out on sparc64. The RPM cataloger checks for it
with isSqliteDriverAvailable() and skips SQLite rpmdbs without it.

--- a/cmd/syft/main.go
+++ b/cmd/syft/main.go
@@ -1,8 +1,6 @@
 package main
 
 import (
-	_ "modernc.org/sqlite"
-
 	"github.com/anchore/clio"
 	"github.com/anchore/syft/cmd/syft/cli"
 	"github.com/anchore/syft/cmd/syft/internal"
--- /dev/null
+++ b/cmd/syft/sqlite.go
@@ -0,0 +1,5 @@
+//go:build !sparc64
+
+package main
+
+import _ "modernc.org/sqlite"
